DATABASE_URL=postgresql+psycopg://rflens:rflens@localhost:5432/rflens
# Password of the read-only database role rflens_docs_reader (migration 0007 creates it).
# Pick your own long random value in .env.
DOCS_READER_PASSWORD=change-me-docs-reader

# Passwords of the database roles rflens_sql_reader (read-only, allow-listed tables and views) and
# rflens_sql_logger (INSERT on sql_query_log only); migration 0008 creates them. Pick your own
# long random values in .env.
SQL_READER_PASSWORD=change-me-sql-reader
SQL_LOGGER_PASSWORD=change-me-sql-logger
# Optional sql-mcp limits (defaults shown): SQL_MAX_COST=500000, SQL_STATEMENT_TIMEOUT_MS=15000,
# SQL_DEFAULT_LIMIT=100, SQL_MAX_LIMIT=1000, SQL_MCP_PORT=8102
# Tests run on their own database in the same Postgres server (created and migrated by `make test`).
# The name must end with _test; the test setup refuses anything else.
TEST_DATABASE_URL=postgresql+psycopg://rflens:rflens@localhost:5432/rflens_test

# LLM gateway. Paid calls are off unless LLM_ALLOW_PAID=true, and are always refused under pytest
# and in CI. Defaults shown; prices live in config/llm_prices.yaml.
# GEMINI_API_KEY=your-key
# LLM_ALLOW_PAID=false
# LLM_PROVIDER=gemini  LLM_MODEL=gemini-3.1-flash-lite  LLM_SERVICE_TIER=standard (or flex)
# LLM_FALLBACK=ollama  LLM_OLLAMA_MODEL=qwen3:4b  LLM_THINKING_BUDGET=minimal
# LLM_BUDGET_USD=2.50  LLM_USD_TO_INR=85.7  LLM_MAX_OUTPUT_TOKENS=2048  LLM_MAX_INPUT_TOKENS=30000
# LLM_MAX_CALLS_PER_RUN=30  LLM_MAX_CALLS_PER_QUESTION=4  LLM_MAX_CALLS_PER_MINUTE=20
# Passwords of the database roles rflens_checkpointer (DML on the checkpoints schema only) and
# rflens_llm_ledger (rights on llm_calls only); migration 0012 creates them. Pick your own long
# random values in .env.
CHECKPOINTER_PASSWORD=change-me-checkpointer
LLM_LEDGER_PASSWORD=change-me-llm-ledger
# Optional orchestrator settings (defaults): ORCH_MAX_CALLS_PER_QUESTION=10, APPROVAL_COST_USD=0.05, ASK=0

# The local HTTP API (make api) and UI (make ui): required for every API route but /health.
API_KEY=change-me-long-random
# Optional: API_RATE_LIMIT_PER_MINUTE=30, API_PORT=8000, API_MAX_QUESTION_CHARS=2000
