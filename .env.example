DATABASE_URL=postgresql+psycopg://rflens:rflens@localhost:5432/rflens
# Password of the read-only database role rflens_docs_reader (migration 0007 creates it).
# Pick your own long random value in .env.
DOCS_READER_PASSWORD=change-me-docs-reader

# Passwords of the database roles rflens_sql_reader (read-only, allow-listed tables and views) and
# rflens_sql_logger (INSERT on sql_query_log only); migration 0008 creates them. Pick your own
# long random values in .env.
SQL_READER_PASSWORD=change-me-sql-reader
SQL_LOGGER_PASSWORD=change-me-sql-logger
# Optional sql-mcp limits (defaults shown): SQL_MAX_COST=500000, SQL_STATEMENT_TIMEOUT_MS=15000,
# SQL_DEFAULT_LIMIT=100, SQL_MAX_LIMIT=1000, SQL_MCP_PORT=8102